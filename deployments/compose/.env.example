# Stowline local compose — no real secrets. Copy to .env and change passwords.
STOWLINE_ADMIN_USERNAME=admin
STOWLINE_ADMIN_PASSWORD=change-me-now
STOWLINE_LAB_MODE=true
STOWLINE_ALLOW_INSECURE_HTTP=true
STOWLINE_GATEWAY_ADMIN_TOKEN=lab-gateway-admin-token
# Workspace: set in untracked .env only. Never commit the unlock password.
# STOWLINE_GATEWAY_ROOT=rclone:stowline-drive:repositories/_qualification/REPLACE_RUN_ID
# RCLONE_CONFIG=/run/secrets/rclone.conf
# RCLONE_CONFIG_PASS=
# Optional gateway aggregate backstop in bytes/s. 4 Mbps = 500000. Never a substitute for WAN-edge QoS.
# STOWLINE_GATEWAY_SITE_LIMITS={"hq":125000,"branch":500000}
POSTGRES_PASSWORD=stowline-lab-only
POSTGRES_DB=stowline
