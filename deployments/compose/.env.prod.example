# Copy to .env next to docker-compose.prod.yml and fill in every value.
# Generate secrets with e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Published images: ghcr.io/<owner>/stowline-server and -gateway (<owner> = the
# GitHub account the project lives under); pin a version for predictable upgrades
STOWLINE_IMAGE_OWNER=canblmz1
STOWLINE_VERSION=latest

# Public DNS name of this server (Caddy gets its HTTPS certificate for it)
STOWLINE_DOMAIN=backup.example.com
# Shown in the admin panel
STOWLINE_ORG_NAME=My Organization

STOWLINE_ADMIN_USERNAME=admin
STOWLINE_ADMIN_PASSWORD=
STOWLINE_SECRET_KEY=
POSTGRES_PASSWORD=
STOWLINE_GATEWAY_ADMIN_TOKEN=
# Optional Key Vault (server-side sealed copies of each computer's backup key);
# losing this value makes stored keys unreadable. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STOWLINE_ESCROW_KEY=

# Where repositories are stored: an rclone remote from your rclone.conf
STOWLINE_GATEWAY_ROOT=rclone:mydrive:stowline-repositories
RCLONE_CONF_FILE=./rclone.conf
# only if rclone.conf is encrypted (`rclone config` -> set configuration password)
RCLONE_CONFIG_PASS=

# Sites, schedules and departments (see deployments/sites.example.json)
SITES_FILE=../sites.example.json
